PORT=8000
NODE_ENV=development

# Database
DATABASE=mongodb://localhost:27017/alrafgha-group
DATABASE_PASSWORD=

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Email
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=Alrafgha Group <noreply@alrafgha-group.com>

# Payment Provider
PAYMENT_PROVIDER=stripe
PAYMENT_MODE=sandbox

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Frontend
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins (overrides default list)
# CORS_ORIGINS=https://your-app.up.railway.app,http://localhost:5173
